---
import BookJacket from '../../components/BookJacket.astro';
import BookGrid from '../../components/BookGrid.astro';
import ButtonLink from '../../components/ButtonLink.astro';
import Container from '../../components/Container.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	formatAuthors,
	formatPrice,
	getBookBySlug,
	getBooks,
	getRelatedBooks,
} from '../../services/books';
import { getHouse } from '../../services/house';

export async function getStaticPaths() {
	const books = await getBooks();
	return books.map((book) => ({
		params: { slug: book.slug },
	}));
}

const { slug } = Astro.params;
const book = slug ? await getBookBySlug(slug) : undefined;

if (!book) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const house = await getHouse();
const related = await getRelatedBooks(book);
const authors = formatAuthors(book);
const orderHref = `mailto:${house.email}?subject=${encodeURIComponent(`Ouvrage — ${book.title}`)}`;

const facts = [
	{ label: 'Collection', value: book.collection.name },
	{ label: 'Parution', value: book.release ?? String(book.year) },
	book.pages ? { label: 'Pages', value: String(book.pages) } : null,
	book.isbn ? { label: 'ISBN', value: book.isbn } : null,
	book.price != null ? { label: 'Prix', value: formatPrice(book.price, book.currency) } : null,
	book.previousEdition ? { label: 'Première édition', value: book.previousEdition } : null,
].filter((fact): fact is { label: string; value: string } => fact !== null);
---

<BaseLayout title={book.title} description={book.synopsis}>
	<Container wide class="py-12 md:py-16">
		<div class="grid items-start justify-items-center gap-10 text-center lg:grid-cols-[16rem_minmax(0,1fr)] lg:justify-items-start lg:gap-16 lg:text-left xl:grid-cols-[18rem_minmax(0,1fr)]">
			<div class="w-full max-w-[16rem] lg:max-w-none">
				<BookJacket book={book} size="hero" />
			</div>

			<div class="w-full">
				<p class="label">{book.collection.name}</p>
				<h1 class="mt-4 font-serif text-4xl font-semibold leading-[1.12] tracking-tight md:text-5xl">
					{book.title}
				</h1>
				{
					book.subtitle && (
						<p class="mt-3 font-body text-xl leading-snug text-ink-muted">{book.subtitle}</p>
					)
				}
				<p class="mt-3 font-body text-xl text-ink">{authors}</p>

				<p class="mx-auto mt-8 max-w-xl font-body text-xl leading-[1.7] text-ink lg:mx-0">
					{book.synopsis}
				</p>

				<dl class="mx-auto mt-10 grid max-w-xl grid-cols-2 gap-x-10 gap-y-6 border-t border-line pt-8 lg:mx-0">
					{
						facts.map((fact) => (
							<div>
								<dt class="label">{fact.label}</dt>
								<dd class="mt-1.5 font-body text-lg">{fact.value}</dd>
							</div>
						))
					}
				</dl>

				<div class="mt-10 flex flex-wrap items-center justify-center gap-8 lg:justify-start">
					<ButtonLink href={orderHref}>Écrire à la maison</ButtonLink>
					<ButtonLink href="/catalogue">Le catalogue</ButtonLink>
				</div>
			</div>
		</div>
	</Container>

	{
		related.length > 0 && (
			<section class="border-t border-line py-12 md:py-16">
				<Container wide>
					<p class="label mb-8">Dans la même collection</p>
					<BookGrid books={related} />
				</Container>
			</section>
		)
	}
</BaseLayout>
