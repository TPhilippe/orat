---
import ButtonLink from '../components/ButtonLink.astro';
import Container from '../components/Container.astro';
import FounderCard from '../components/FounderCard.astro';
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollections, getHouse } from '../services/house';

const house = await getHouse();
const collections = await getCollections();
---

<BaseLayout
	title="La maison"
	description="Éditions Orat, maison d’édition suisse indépendante fondée à Môtier en 2026."
>
	<Container wide>
		<PageIntro eyebrow="La maison" title={house.name}>
			{house.tagline} Fondée à {house.city} en {house.founded}.
		</PageIntro>
	</Container>

	<section class="py-12 md:py-16">
		<Container narrow>
			<div class="space-y-6 font-body text-xl leading-[1.7] text-ink">
				{house.history.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</Container>
	</section>

	{
		house.strengths.map((strength) => (
			<section class="border-t border-line py-12 md:py-16">
				<Container narrow>
					<p class="label mb-4">L’objet-livre</p>
					<h2 class="font-serif text-3xl font-semibold tracking-tight md:text-4xl">{strength.title}</h2>
					<div class="mt-6 space-y-5 font-body text-xl leading-[1.7] text-ink">
						{strength.body.map((paragraph) => (
							<p>{paragraph}</p>
						))}
					</div>
				</Container>
			</section>
		))
	}

	<section class="border-t border-line py-12 md:py-16">
		<Container wide>
			<p class="label mb-8">Les fondateurs</p>
			<div class="space-y-12 md:space-y-16">
				{house.founders.map((founder) => <FounderCard founder={founder} />)}
			</div>
		</Container>
	</section>

	<section class="border-t border-line py-12 md:py-16">
		<Container wide>
			<p class="label mb-8">Collections</p>
			<div class="grid gap-10 md:grid-cols-2 md:gap-16">
				{
					collections.map((collection) => (
						<article>
							<h2 class="font-serif text-3xl font-semibold tracking-tight">{collection.name}</h2>
							<p class="mt-3 font-body text-xl leading-relaxed text-ink">
								{collection.description}
							</p>
							<a href={`/catalogue#${collection.slug}`} class="editorial-link mt-5 inline-block">
								Les titres
							</a>
						</article>
					))
				}
			</div>
		</Container>
	</section>

	<section class="border-t border-line py-12 md:py-16">
		<Container narrow>
			<p class="label">Présentation</p>
			<p class="mt-4 max-w-xl font-body text-xl leading-relaxed text-ink">
				La présentation 2026 de la maison : ligne éditoriale, fondateurs, points forts et premières parutions.
			</p>
			<div class="mt-6">
				<ButtonLink href={house.presentationPdf}>Télécharger le PDF</ButtonLink>
			</div>
		</Container>
	</section>
</BaseLayout>
