---
import ContactForm from '../components/ContactForm.astro';
import Container from '../components/Container.astro';
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHouse } from '../services/house';

const house = await getHouse();
const websiteLabel = house.website.replace(/^https?:\/\//, '');
---

<BaseLayout
	title="Contact"
	description="Écrire aux Éditions Orat, commander un livre, ou nous rendre visite à Môtier."
>
	<Container>
		<PageIntro eyebrow="Contact" title="Nous écrire">
			Pour une commande, une presse, un manuscrit, ou simplement une lettre.
		</PageIntro>
	</Container>

	<section class="py-12 md:py-16">
		<Container wide>
			<div class="grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-20">
				<div>
					<p class="label">Adresse</p>
					<p class="mt-4 font-serif text-2xl font-semibold leading-snug md:text-3xl">
						{house.legalName}
						<br />
						{house.address.map((line) => (
							<>
								{line}
								<br />
							</>
						))}
					</p>
					<div class="mt-8 space-y-2 font-body text-xl">
						<p>
							<a href={`mailto:${house.email}`} class="font-medium hover:text-accent">{house.email}</a>
						</p>
						<p>
							<a href={house.website} class="hover:text-accent">{websiteLabel}</a>
						</p>
						{
							house.phone && <p class="text-ink-muted">{house.phone}</p>
						}
					</div>
				</div>

				<div>
					<ContactForm email={house.email} />
				</div>
			</div>
		</Container>
	</section>
</BaseLayout>
