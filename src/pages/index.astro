---
import BookGrid from '../components/BookGrid.astro';
import Container from '../components/Container.astro';
import FeaturedBook from '../components/FeaturedBook.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { getFeaturedBooks, getBooks } from '../services/books';
import { getHouse } from '../services/house';

const house = await getHouse();
const featured = await getFeaturedBooks();
const books = await getBooks();
const hero = featured[0] ?? books[0];
const others = (featured.length ? featured : books).filter((book) => book.id !== hero?.id).slice(0, 2);
---

<BaseLayout title={site.name} description={site.description}>
	<section>
		<Container wide class="pb-12 pt-12 md:pb-16 md:pt-16">
			<p class="label">Maison d’édition · {house.city}</p>
			<h1
				class="mt-5 max-w-5xl font-serif text-4xl font-semibold leading-[1.12] tracking-tight text-ink md:text-6xl lg:text-7xl"
			>
				Des chemins qui ramènent à l’essentiel.
			</h1>
			<p class="mt-6 max-w-2xl font-body text-xl leading-[1.7] text-ink md:text-[1.4rem]">
				{house.statement[0]}
			</p>
		</Container>
	</section>

	{
		hero && (
			<section class="border-t border-line">
				<Container wide class="py-12 md:py-16">
					<p class="label mb-8">À paraître · janvier–mars 2027</p>
					<FeaturedBook book={hero} />
				</Container>
			</section>
		)
	}

	{
		others.length > 0 && (
			<section class="border-t border-line">
				<Container wide class="py-12 md:py-16">
					<div class="mb-8 flex items-baseline justify-between gap-8">
						<p class="label">Autres titres</p>
						<a href="/catalogue" class="editorial-link">
							Le catalogue
						</a>
					</div>
					<BookGrid books={others} />
				</Container>
			</section>
		)
	}

	<section class="border-t border-line">
		<Container narrow class="py-14 md:py-20">
			<blockquote class="font-serif text-3xl font-semibold leading-snug tracking-tight md:text-4xl">
				{house.tagline}
			</blockquote>
			<p class="mt-8 font-body text-xl leading-[1.7] text-ink">
				{house.history[0]}
			</p>
			<a href="/maison" class="editorial-link mt-8 inline-block">
				La maison
			</a>
		</Container>
	</section>
</BaseLayout>
