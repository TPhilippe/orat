---
import BookGrid from '../components/BookGrid.astro';
import Container from '../components/Container.astro';
import FeaturedBook from '../components/FeaturedBook.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { getFeaturedBooks, getBooks } from '../services/books';
import { getHouse } from '../services/house';

const house = await getHouse();
const featured = await getFeaturedBooks();
const books = await getBooks();
const hero = featured[0] ?? books[0];
const others = (featured.length ? featured : books).filter((book) => book.id !== hero?.id).slice(0, 2);
---

<BaseLayout title={site.name} description={site.description}>
	<section>
		<Container wide class="pb-20 pt-24 md:pb-28 md:pt-36">
			<p class="label">Maison d’édition · {house.city}</p>
			<h1
				class="mt-10 max-w-5xl font-serif text-5xl font-medium italic leading-[1.06] tracking-tight text-ink md:text-7xl lg:text-8xl"
			>
				Des chemins qui ramènent à l’essentiel.
			</h1>
			<p class="mt-12 max-w-lg font-body text-xl leading-[1.8] text-ink-muted md:text-[1.35rem]">
				{house.statement[0]}
			</p>
		</Container>
	</section>

	{
		hero && (
			<section class="border-t border-line">
				<Container wide class="py-24 md:py-32">
					<p class="label mb-16 md:mb-20">À paraître · janvier–mars 2027</p>
					<FeaturedBook book={hero} />
				</Container>
			</section>
		)
	}

	{
		others.length > 0 && (
			<section class="border-t border-line">
				<Container wide class="py-24 md:py-32">
					<div class="mb-16 flex items-baseline justify-between gap-8 md:mb-20">
						<p class="label">Autres titres</p>
						<a href="/catalogue" class="editorial-link">
							Le catalogue
						</a>
					</div>
					<BookGrid books={others} />
				</Container>
			</section>
		)
	}

	<section class="border-t border-line">
		<Container narrow class="py-28 md:py-36">
			<blockquote class="font-serif text-3xl font-medium italic leading-snug tracking-tight md:text-5xl">
				{house.tagline}
			</blockquote>
			<p class="mt-12 font-body text-xl leading-[1.85] text-ink">
				{house.history[0]}
			</p>
			<a href="/maison" class="editorial-link mt-12 inline-block">
				La maison
			</a>
		</Container>
	</section>
</BaseLayout>
