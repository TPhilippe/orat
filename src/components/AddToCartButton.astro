---
import { cartActionLabel } from '../services/books';
import type { Book } from '../types';

interface Props {
	slug: string;
	book?: Pick<Book, 'status' | 'inStock' | 'cover'>;
	label?: string;
	class?: string;
}

const { slug, book, label, class: className } = Astro.props;
const hint = label ?? (book ? cartActionLabel(book) : 'Ajouter au panier');
---

<button
	type="button"
	class:list={[
		'relative inline-grid size-12 cursor-pointer place-items-center text-ink-muted transition-colors hover:text-ink',
		className,
	]}
	data-add-cart={slug}
	data-cover={book?.cover.front}
	data-hint={hint}
	aria-label={hint}
>
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-6" fill="none" aria-hidden="true">
		<path d="M7 8h10l-.85 11.2a1.5 1.5 0 0 1-1.5 1.3H9.35a1.5 1.5 0 0 1-1.5-1.3L7 8Z" stroke="currentColor" stroke-width="1.2" />
		<path d="M9.5 8V7.2a2.5 2.5 0 0 1 5 0V8" stroke="currentColor" stroke-width="1.2" />
		<path d="M12 12.5v4M10 14.5h4" stroke="currentColor" stroke-width="1.2" />
	</svg>
</button>
