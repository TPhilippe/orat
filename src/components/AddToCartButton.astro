---
import { cartActionLabel } from '../services/books';
import type { Book } from '../types';
import CartIcon from './CartIcon.astro';

interface Props {
	slug: string;
	book?: Pick<Book, 'status' | 'inStock' | 'cover'>;
	label?: string;
	class?: string;
}

const { slug, book, label, class: className } = Astro.props;
const hint = label ?? (book ? cartActionLabel(book) : 'Ajouter au panier');
---

<button
	type="button"
	class:list={[
		'relative inline-grid size-12 cursor-pointer place-items-center text-ink-muted transition-colors hover:text-ink',
		className,
	]}
	data-add-cart={slug}
	data-cover={book?.cover.front}
	data-hint={hint}
	aria-label={hint}
>
	<span class="relative inline-grid">
		<CartIcon class="size-6" />
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 10 10"
			class="pointer-events-none absolute -top-1.5 -right-1.5 size-2.5"
			fill="none"
			aria-hidden="true"
		>
			<path d="M5 1.1v7.8M1.1 5h7.8" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
		</svg>
	</span>
</button>
