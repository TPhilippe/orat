---
import CartWidget from './CartWidget.astro';
import { navigation, site } from '../data/site';
import { getBooks, toShopBook } from '../services/books';

const pathname = Astro.url.pathname;
const current = pathname.endsWith('/') && pathname !== '/' ? pathname.slice(0, -1) : pathname;
const catalog = (await getBooks()).map(toShopBook);

function isActive(href: string) {
	if (href === '/') return current === '/';
	if (href === '/catalogue') {
		return current === '/catalogue' || current.startsWith('/livres/');
	}
	return current === href || current.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-50 overflow-visible border-b border-line bg-paper" data-site-header>
	<div class="mx-auto flex max-w-[1400px] items-center justify-between gap-3 px-3 py-4 sm:px-6 sm:py-5 md:gap-8 md:px-12 md:py-6 lg:px-16">
		<a href="/" class="shrink-0" aria-label={site.name}>
			<img
				src="/logos/orat.png"
				alt={site.name}
				width="190"
				height="50"
				class="h-7 w-auto sm:h-8 md:h-9"
			/>
		</a>

		<div class="flex shrink-0 items-center">
			<nav class="mr-8 hidden md:block lg:mr-9" aria-label="Navigation principale">
				<ul class="flex flex-nowrap items-center gap-5 md:gap-8 lg:gap-9">
					{
						navigation.map((item) => (
							<li class="shrink-0 whitespace-nowrap">
								<a
									href={item.href}
									class:list={[
										'inline-block whitespace-nowrap pr-[0.12em] font-sans text-[0.75rem] font-semibold tracking-[0.1em] uppercase transition-colors duration-200 hover:text-accent md:text-[0.875rem] md:tracking-[0.12em]',
										isActive(item.href) ? 'text-ink' : 'text-ink-muted',
									]}
									aria-current={isActive(item.href) ? 'page' : undefined}
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<button
				type="button"
				class="grid size-12 cursor-pointer place-items-center text-ink-muted transition-colors hover:text-ink md:hidden"
				aria-label="Menu"
				aria-controls="menu-mobile"
				aria-expanded="false"
				data-menu-toggle
			>
				<svg data-menu-open xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-6" fill="none" aria-hidden="true">
					<path d="M5 7h14M5 12h14M5 17h14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
				</svg>
				<svg data-menu-close xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="hidden size-6" fill="none" aria-hidden="true">
					<path d="M6.5 6.5 17.5 17.5M17.5 6.5 6.5 17.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
				</svg>
			</button>

			<CartWidget catalog={catalog} />
		</div>
	</div>

	<nav
		id="menu-mobile"
		class="hidden border-t border-line md:hidden"
		aria-label="Navigation mobile"
		data-menu-panel
	>
		<ul class="px-3 py-4 sm:px-6">
			{
				navigation.map((item) => (
					<li>
						<a
							href={item.href}
							class:list={[
								'block py-3 font-sans text-[0.8125rem] font-semibold tracking-[0.12em] uppercase transition-colors hover:text-accent',
								isActive(item.href) ? 'text-ink' : 'text-ink-muted',
							]}
							aria-current={isActive(item.href) ? 'page' : undefined}
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<script>
	const header = document.querySelector('[data-site-header]');
	const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const panel = header?.querySelector<HTMLElement>('[data-menu-panel]');
	const openIcon = toggle?.querySelector('[data-menu-open]');
	const closeIcon = toggle?.querySelector('[data-menu-close]');

	function setOpen(open: boolean) {
		panel?.classList.toggle('hidden', !open);
		openIcon?.classList.toggle('hidden', open);
		closeIcon?.classList.toggle('hidden', !open);
		toggle?.setAttribute('aria-expanded', String(open));
		toggle?.setAttribute('aria-label', open ? 'Fermer le menu' : 'Menu');
	}

	toggle?.addEventListener('click', () => {
		setOpen(panel?.classList.contains('hidden') ?? true);
	});
</script>
