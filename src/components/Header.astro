---
import { navigation, site } from '../data/site';

const pathname = Astro.url.pathname;
const current = pathname.endsWith('/') && pathname !== '/' ? pathname.slice(0, -1) : pathname;

function isActive(href: string) {
	if (href === '/') return current === '/';
	if (href === '/catalogue') {
		return current === '/catalogue' || current.startsWith('/livres/');
	}
	return current === href || current.startsWith(`${href}/`);
}
---

<header class="border-b border-line">
	<div class="mx-auto flex max-w-[1400px] items-center justify-between gap-8 px-6 py-5 md:px-12 md:py-6 lg:px-16">
		<a href="/" class="shrink-0" aria-label={site.name}>
			<img
				src="/logos/orat.png"
				alt={site.name}
				width="190"
				height="50"
				class="h-8 w-auto md:h-9"
			/>
		</a>

		<nav aria-label="Navigation principale">
			<ul class="flex flex-nowrap items-center gap-4 sm:gap-6 md:gap-9">
				{
					navigation.map((item) => (
						<li class="shrink-0">
							<a
								href={item.href}
								class:list={[
									'whitespace-nowrap font-sans text-[0.75rem] font-semibold tracking-[0.1em] uppercase transition-colors duration-200 hover:text-accent md:text-[0.875rem] md:tracking-[0.12em]',
									isActive(item.href) ? 'text-ink' : 'text-ink-muted',
								]}
								aria-current={isActive(item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
