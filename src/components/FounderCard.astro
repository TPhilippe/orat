---
import type { Founder } from '../types';

interface Props {
	founder: Founder;
}

const { founder } = Astro.props;
---

<article
	class:list={[
		'grid items-start gap-6 md:gap-10',
		founder.portrait && 'md:grid-cols-[13rem_minmax(0,1fr)]',
	]}
>
	{
		founder.portrait && (
			<figure class="max-w-[13rem]">
				<img
					src={founder.portrait}
					alt={founder.name}
					width="320"
					height="400"
					class="aspect-[4/5] w-full object-cover object-[center_18%]"
				/>
			</figure>
		)
	}
	<div class={founder.portrait ? 'md:pt-0' : 'max-w-2xl'}>
		<p class="label">{founder.origin}</p>
		<h2 class="mt-3 font-serif text-3xl font-semibold tracking-tight md:text-4xl">{founder.name}</h2>
		<p class="mt-4 font-body text-xl leading-[1.7] text-ink">{founder.bio}</p>
		<ul class="mt-5 space-y-2 font-body text-lg leading-relaxed text-ink">
			{founder.highlights.map((item) => <li>{item}</li>)}
		</ul>
		{
			founder.website && (
				<a href={founder.website} class="editorial-link mt-6 inline-block">
					Site personnel
				</a>
			)
		}
	</div>
</article>
