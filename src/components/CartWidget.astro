---
import type { ShopBook } from '../services/books';
import CartIcon from './CartIcon.astro';

interface Props {
	catalog: ShopBook[];
}

const { catalog } = Astro.props;
---

<div class="group/cart relative z-50 shrink-0" data-cart-widget>
	<a
		href="/shop/cart"
		class="relative grid size-12 cursor-pointer place-items-center text-ink-muted transition-colors hover:text-ink"
		aria-label="Panier"
		data-cart-link
	>
		<span class="relative inline-grid">
			<CartIcon class="size-[1.5rem]" />
			<span
				class="absolute -top-1.5 -right-1.5 z-10 hidden min-w-[1.1rem] rounded-full bg-accent px-1 text-center font-sans text-[0.62rem] font-semibold leading-[1.1rem] text-paper"
				data-cart-badge
			></span>
		</span>
	</a>

	<div
		class="pointer-events-none invisible absolute right-0 top-full z-40 hidden w-[min(calc(100vw-2rem),22rem)] pt-3 opacity-0 transition-opacity duration-150 group-hover/cart:pointer-events-auto group-hover/cart:visible group-hover/cart:opacity-100 md:block"
		data-cart-dropdown
	>
		<div class="border border-line bg-paper-raised p-5 shadow-[0_16px_40px_rgb(27_24_20_/_0.08)]">
			<p class="label">Panier</p>
			<div data-cart-dropdown-body class="mt-4"></div>
		</div>
	</div>
</div>

<script type="application/json" id="cart-catalog" set:html={JSON.stringify(catalog)} />

<script>
	import { addToCart, cartCount, readCart, setQuantity } from '../lib/cart';
	import { trash3Svg } from '../lib/icons';
	import type { ShopBook } from '../services/books';

	const catalog: ShopBook[] = JSON.parse(document.getElementById('cart-catalog')?.textContent ?? '[]');

	function bookOf(slug: string) {
		return catalog.find((book) => book.slug === slug);
	}

	function formatAmount(amount: number, currency: ShopBook['currency']) {
		return new Intl.NumberFormat('fr-CH', {
			style: 'currency',
			currency,
			minimumFractionDigits: Number.isInteger(amount) ? 0 : 2,
			maximumFractionDigits: 2,
		}).format(amount);
	}

	function goToCartLink() {
		const go = document.createElement('a');
		go.href = '/shop/cart';
		go.className =
			'mt-5 inline-flex w-full cursor-pointer items-center justify-center bg-ink px-4 py-3 font-sans text-[0.75rem] font-semibold tracking-[0.14em] text-paper uppercase transition-colors hover:bg-accent';
		go.textContent = 'Aller au panier';
		return go;
	}

	function prefersReducedMotion() {
		return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	}

	function pulseCart() {
		const link = document.querySelector<HTMLElement>('[data-cart-link]');
		if (!link) return;
		link.classList.remove('orat-cart-receive');
		void link.offsetWidth;
		link.classList.add('orat-cart-receive');
		window.setTimeout(() => link.classList.remove('orat-cart-receive'), 450);
	}

	function originRect(add: HTMLElement): DOMRect {
		return add.getBoundingClientRect();
	}

	function flyCoverToCart(add: HTMLElement, slug: string) {
		const target = document.querySelector<HTMLElement>('[data-cart-link]');
		const src = add.dataset.cover || bookOf(slug)?.cover;
		if (!target) return;

		if (prefersReducedMotion() || !src) {
			pulseCart();
			return;
		}

		const from = originRect(add);
		const to = target.getBoundingClientRect();
		const flyer = document.createElement('img');
		flyer.className = 'orat-cart-flyer';
		flyer.src = src;
		flyer.alt = '';
		flyer.setAttribute('aria-hidden', 'true');
		document.body.append(flyer);

		const startW = 108;
		const startH = startW * 1.5;
		const startX = from.left + from.width / 2;
		const startY = from.top + from.height / 2;
		const endX = to.left + to.width / 2;
		const endY = to.top + to.height / 2;
		const dx = endX - startX;
		const dy = endY - startY;

		flyer.style.width = `${startW}px`;
		flyer.style.height = `${startH}px`;
		flyer.style.left = `${startX}px`;
		flyer.style.top = `${startY}px`;

		const animation = flyer.animate(
			[
				{
					transform: 'translate(-50%, -50%) scale(1) rotate(-3deg)',
					opacity: 0.88,
				},
				{
					transform: `translate(calc(-50% + ${dx * 0.42}px), calc(-50% + ${dy * 0.28 - 28}px)) scale(0.9) rotate(4deg)`,
					opacity: 0.7,
					offset: 0.58,
				},
				{
					transform: `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px)) scale(0.28) rotate(7deg)`,
					opacity: 0.12,
				},
			],
			{
				duration: 1150,
				easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
				fill: 'forwards',
			},
		);

		animation.finished.finally(() => {
			flyer.remove();
			pulseCart();
		});
	}

	function renderWidget() {
		const widgets = document.querySelectorAll<HTMLElement>('[data-cart-widget]');
		const items = readCart();
		const count = cartCount(items);

		widgets.forEach((widget) => {
			const badge = widget.querySelector<HTMLElement>('[data-cart-badge]');
			const body = widget.querySelector<HTMLElement>('[data-cart-dropdown-body]');
			const link = widget.querySelector<HTMLAnchorElement>('[data-cart-link]');
			if (badge) {
				badge.textContent = String(count);
				badge.classList.toggle('hidden', count === 0);
			}
			if (link) {
				link.setAttribute('aria-label', count ? `Panier, ${count} article${count > 1 ? 's' : ''}` : 'Panier');
			}
			if (!body) return;

			const rows = items
				.map((item) => ({ item, book: bookOf(item.slug) }))
				.filter((row): row is { item: (typeof items)[number]; book: ShopBook } => Boolean(row.book));

			if (!rows.length) {
				body.replaceChildren();
				const empty = document.createElement('p');
				empty.className = 'font-body text-lg text-ink-muted';
				empty.textContent = 'Votre panier est vide.';
				body.append(empty, goToCartLink());
				return;
			}

			const table = document.createElement('table');
			table.className = 'w-full border-collapse';
			const tbody = document.createElement('tbody');
			let total = 0;
			let priced = true;

			for (const { item, book } of rows) {
				if (book.price == null) priced = false;
				else total += book.price * item.quantity;

				const title = document.createElement('p');
				title.className = 'font-serif text-lg font-semibold leading-snug';
				title.textContent = book.title;

				const nameCell = document.createElement('td');
				nameCell.className = 'w-full py-3 pr-3 align-middle';
				nameCell.append(title);

				const minus = document.createElement('button');
				minus.type = 'button';
				minus.dataset.qty = book.slug;
				minus.dataset.delta = '-1';
				minus.className = 'grid size-7 cursor-pointer place-items-center text-ink-muted hover:text-ink';
				minus.setAttribute('aria-label', `Diminuer ${book.title}`);
				minus.textContent = '−';

				const value = document.createElement('span');
				value.className = 'min-w-[1.5rem] text-center font-body text-base';
				value.textContent = String(item.quantity);

				const plus = document.createElement('button');
				plus.type = 'button';
				plus.dataset.qty = book.slug;
				plus.dataset.delta = '1';
				plus.className = 'grid size-7 cursor-pointer place-items-center text-ink-muted hover:text-ink';
				plus.setAttribute('aria-label', `Augmenter ${book.title}`);
				plus.textContent = '+';

				const qty = document.createElement('div');
				qty.className = 'flex items-center justify-center gap-0.5';
				qty.append(minus, value, plus);

				const qtyCell = document.createElement('td');
				qtyCell.className = 'whitespace-nowrap py-3 pl-2 align-middle';
				qtyCell.append(qty);

				const linePrice = document.createElement('p');
				linePrice.className = 'font-body text-base tabular-nums';
				linePrice.textContent =
					book.price != null ? formatAmount(book.price * item.quantity, book.currency) : book.priceLabel;

				const priceCell = document.createElement('td');
				priceCell.className = 'whitespace-nowrap py-3 pl-3 align-middle text-right';
				priceCell.append(linePrice);

				const remove = document.createElement('button');
				remove.type = 'button';
				remove.dataset.remove = book.slug;
				remove.dataset.hint = 'Retirer l’article du panier';
				remove.className = 'grid size-7 cursor-pointer place-items-center text-ink-muted hover:text-ink';
				remove.setAttribute('aria-label', `Retirer ${book.title}`);
				remove.innerHTML = trash3Svg('size-4');

				const removeCell = document.createElement('td');
				removeCell.className = 'whitespace-nowrap py-3 pl-2 align-middle';
				removeCell.append(remove);

				const tr = document.createElement('tr');
				tr.className = 'border-b border-line';
				tr.append(nameCell, qtyCell, priceCell, removeCell);
				tbody.append(tr);
			}

			const totalWord = document.createElement('p');
			totalWord.className = 'font-body text-base font-bold';
			totalWord.textContent = 'Total';
			const totalLabelCell = document.createElement('td');
			totalLabelCell.className = 'whitespace-nowrap py-4 pl-2 align-middle text-center';
			totalLabelCell.append(totalWord);

			const totalValue = document.createElement('p');
			totalValue.className = 'font-body text-base font-bold tabular-nums';
			totalValue.textContent = priced
				? formatAmount(total, rows[0]?.book.currency ?? 'CHF')
				: 'Prix communiqué';
			const totalCell = document.createElement('td');
			totalCell.className = 'whitespace-nowrap py-4 pl-3 align-middle text-right';
			totalCell.append(totalValue);

			const foot = document.createElement('tr');
			foot.className = 'border-t border-line';
			foot.append(document.createElement('td'), totalLabelCell, totalCell, document.createElement('td'));
			const tfoot = document.createElement('tfoot');
			tfoot.append(foot);

			table.append(tbody, tfoot);
			body.replaceChildren(table, goToCartLink());
		});
	}

	document.addEventListener('click', (event) => {
		const add = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-add-cart]');
		if (add?.dataset.addCart) {
			event.preventDefault();
			const slug = add.dataset.addCart;
			addToCart(slug, 1);
			flyCoverToCart(add, slug);
			renderWidget();
			return;
		}

		const inDropdown = (event.target as HTMLElement | null)?.closest('[data-cart-dropdown]');
		if (!inDropdown) return;

		const qty = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-qty]');
		if (qty?.dataset.qty) {
			event.preventDefault();
			event.stopPropagation();
			const current = readCart().find((item) => item.slug === qty.dataset.qty)?.quantity ?? 1;
			const next = current + Number(qty.dataset.delta);
			setQuantity(qty.dataset.qty, next);
			renderWidget();
			return;
		}

		const remove = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-remove]');
		if (remove?.dataset.remove) {
			event.preventDefault();
			event.stopPropagation();
			setQuantity(remove.dataset.remove, 0);
			renderWidget();
		}
	});

	window.addEventListener('orat-cart', () => renderWidget());
	renderWidget();
</script>
