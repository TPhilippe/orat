---
import { site } from '../data/site';

interface Props {
	email: string;
}

const { email } = Astro.props;
---

<form id="contact-form" class="relative space-y-7" novalidate>
	<div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
		<label>
			Site web
			<input type="text" name="company" tabindex="-1" autocomplete="off" />
		</label>
	</div>

	<div class="grid gap-7 md:grid-cols-2">
		<label class="block">
			<span class="label">Nom</span>
			<input
				type="text"
				name="name"
				required
				autocomplete="name"
				class="mt-2 w-full border-0 border-b border-line bg-transparent py-3 text-xl text-ink outline-none transition-colors focus:border-ink"
			/>
		</label>
		<label class="block">
			<span class="label">Courriel</span>
			<input
				type="email"
				name="email"
				required
				autocomplete="email"
				class="mt-2 w-full border-0 border-b border-line bg-transparent py-3 text-xl text-ink outline-none transition-colors focus:border-ink"
			/>
		</label>
	</div>

	<label class="block">
		<span class="label">Message</span>
		<textarea
			name="message"
			required
			rows="5"
			class="mt-2 w-full resize-y border-0 border-b border-line bg-transparent py-3 text-xl text-ink outline-none transition-colors focus:border-ink"></textarea>
	</label>

	<button type="submit" class="editorial-link bg-transparent">
		Envoyer
	</button>

	<p id="contact-status" class="hidden font-body text-base text-ink-muted" role="status"></p>
</form>

<script define:vars={{ houseEmail: email, houseName: site.name }}>
	const form = document.getElementById('contact-form');
	const status = document.getElementById('contact-status');

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (!(form instanceof HTMLFormElement)) return;

		const data = new FormData(form);
		if (String(data.get('company') ?? '').trim()) return;

		const name = String(data.get('name') ?? '').trim();
		const from = String(data.get('email') ?? '').trim();
		const message = String(data.get('message') ?? '').trim();

		const subject = encodeURIComponent(`Message — ${houseName}`);
		const body = encodeURIComponent(`${message}\n\n— ${name}\n${from}`);
		window.location.href = `mailto:${houseEmail}?subject=${subject}&body=${body}`;

		if (status) {
			status.textContent = 'Votre client de messagerie va s’ouvrir.';
			status.classList.remove('hidden');
		}
	});
</script>
