---
import type { Book } from '../types';
import { excerpt, formatAuthors } from '../services/books';
import BookJacket from './BookJacket.astro';

interface Props {
	book: Book;
}

const { book } = Astro.props;
const authors = formatAuthors(book);
const lead = excerpt(book.synopsis, 2);
---

<article class="grid items-start justify-items-center gap-8 text-center lg:grid-cols-[16rem_minmax(0,1fr)] lg:justify-items-start lg:gap-16 lg:text-left xl:grid-cols-[18rem_minmax(0,1fr)]">
	<div class="w-full max-w-[16rem] lg:max-w-none">
		<BookJacket book={book} size="hero" />
	</div>

	<div class="w-full max-w-2xl lg:pt-1">
		<p class="label">{book.collection.name}</p>
		<h2 class="mt-4 font-serif text-3xl font-semibold leading-[1.12] tracking-tight md:text-5xl">
			<a href={`/livres/${book.slug}`} class="hover:text-accent">
				{book.title}
			</a>
		</h2>
		{
			book.subtitle && (
				<p class="mt-3 font-body text-xl leading-snug text-ink-muted">{book.subtitle}</p>
			)
		}
		<p class="mt-3 font-body text-xl text-ink">{authors}</p>
		<p class="mt-6 font-body text-xl leading-[1.7] text-ink">{lead}</p>
		<a href={`/livres/${book.slug}`} class="editorial-link mt-8 inline-block">
			Lire
		</a>
	</div>
</article>
