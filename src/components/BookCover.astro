---
import type { Book } from '../types';
import { formatAuthors } from '../services/books';

interface Props {
	book: Book;
	size?: 'default' | 'hero';
	class?: string;
}

const { book, size = 'default', class: className } = Astro.props;
const authors = formatAuthors(book);
const hero = size === 'hero';
---

<div
	class:list={[
		'relative flex aspect-[2/3] flex-col overflow-hidden',
		hero ? 'px-8 py-9 md:px-11 md:py-12' : 'px-6 py-7 md:px-8 md:py-8',
		className,
	]}
	style={`background-color: ${book.cover.background}; color: ${book.cover.foreground};`}
	aria-hidden="true"
>
	<p class:list={['tracking-[0.28em] uppercase opacity-65', hero ? 'text-[0.7rem]' : 'text-[0.62rem]']}>
		{book.collection.name}
	</p>
	<div class="flex flex-1 items-center py-8">
		<p
			class:list={[
				'font-serif font-medium leading-[1.12] tracking-tight',
				hero ? 'text-4xl md:text-5xl lg:text-[3.35rem]' : 'text-[1.7rem] md:text-3xl',
			]}
		>
			{book.title}
		</p>
	</div>
	<div>
		<p class:list={['tracking-[0.14em] uppercase opacity-80', hero ? 'text-xs' : 'text-[0.68rem]']}>
			{authors}
		</p>
		<p class="mt-4 text-[0.58rem] tracking-[0.32em] uppercase opacity-55">Éditions Orat</p>
	</div>
</div>
