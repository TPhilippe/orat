---
interface Props {
	href: string;
	variant?: 'solid' | 'ghost';
	class?: string;
}

const { href, variant = 'ghost', class: className } = Astro.props;
---

<a
	href={href}
	class:list={[
		variant === 'solid' &&
			'inline-flex items-center bg-ink px-8 py-3.5 font-sans text-[0.7rem] tracking-[0.22em] text-paper uppercase transition-colors hover:bg-accent',
		variant === 'ghost' && 'editorial-link inline-block',
		className,
	]}
>
	<slot />
</a>
