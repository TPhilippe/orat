---
import type { Book } from '../types';
import { availabilityLabel, formatAuthors, priceLabel } from '../services/books';
import AddToCartButton from './AddToCartButton.astro';
import BookJacket from './BookJacket.astro';

interface Props {
	book: Book;
	size?: 'default' | 'hero';
	shop?: boolean;
}

const { book, size = 'default', shop = false } = Astro.props;
const authors = formatAuthors(book);
---

<article class="flex flex-col items-center overflow-visible text-center">
	<div class="w-full max-w-[13.5rem]">
		<BookJacket book={book} size={size} />
	</div>
	{
		shop ? (
			<div class="mt-4 w-full max-w-[16rem]">
				<p class="label">{availabilityLabel(book)}</p>
				<h2
					class:list={[
						'mt-2 font-serif font-semibold leading-snug tracking-tight',
						size === 'hero' ? 'text-2xl md:text-3xl' : 'text-xl md:text-2xl',
					]}
				>
					<a href={`/livres/${book.slug}`} class="hover:text-accent">
						{book.title}
					</a>
				</h2>
				<p class="mt-1.5 font-body text-lg text-ink-muted">{authors}</p>
				<div class="mt-3 flex items-center justify-center gap-3">
					<p class="font-body text-xl">{priceLabel(book)}</p>
					<AddToCartButton slug={book.slug} book={book} />
				</div>
			</div>
		) : (
			<div class="mt-4 w-full max-w-[13.5rem]">
				<a href={`/livres/${book.slug}`} class="group block">
					<h2
						class:list={[
							'font-serif font-semibold leading-snug tracking-tight text-ink group-hover:text-accent',
							size === 'hero' ? 'text-2xl md:text-3xl' : 'text-xl md:text-2xl',
						]}
					>
						{book.title}
					</h2>
					<p class="mt-1.5 font-body text-lg text-ink-muted">{authors}</p>
				</a>
				<div class="mt-2 flex justify-center">
					<AddToCartButton slug={book.slug} book={book} />
				</div>
			</div>
		)
	}
</article>
