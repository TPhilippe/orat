---
interface Props {
	eyebrow?: string;
	title: string;
	class?: string;
}

const { eyebrow, title, class: className } = Astro.props;
---

<header class:list={['border-b border-line pb-10 pt-12 md:pb-12 md:pt-16', className]}>
	{eyebrow && <p class="label mb-4">{eyebrow}</p>}
	<h1 class="max-w-4xl font-serif text-4xl font-semibold leading-[1.12] tracking-tight text-ink md:text-5xl lg:text-6xl">
		{title}
	</h1>
	{
		Astro.slots.has('default') && (
			<div class="mt-5 max-w-2xl font-body text-xl leading-[1.7] text-ink">
				<slot />
			</div>
		)
	}
</header>
