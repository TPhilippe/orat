---
interface Props {
	class?: string;
	narrow?: boolean;
	wide?: boolean;
}

const { class: className, narrow = false, wide = false } = Astro.props;
const width = narrow ? 'max-w-2xl' : wide ? 'max-w-[1400px]' : 'max-w-6xl';
---

<div class:list={['mx-auto px-6 md:px-12 lg:px-16', width, className]}>
	<slot />
</div>
