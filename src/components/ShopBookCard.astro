---
import type { Book } from '../types';
import { availabilityLabel, formatAuthors, priceLabel, shopHref, shopLabel } from '../services/books';
import BookJacket from './BookJacket.astro';
import ButtonLink from './ButtonLink.astro';

interface Props {
	book: Book;
}

const { book } = Astro.props;
const authors = formatAuthors(book);
---

<article class="flex flex-col items-center text-center">
	<div class="w-full max-w-[13.5rem]">
		<BookJacket book={book} size="default" />
	</div>
	<div class="mt-4 w-full max-w-[16rem]">
		<p class="label">{availabilityLabel(book)}</p>
		<h2 class="mt-2 font-serif text-xl font-semibold leading-snug tracking-tight md:text-2xl">
			<a href={`/livres/${book.slug}`} class="hover:text-accent">{book.title}</a>
		</h2>
		<p class="mt-1.5 font-body text-lg text-ink-muted">{authors}</p>
		<p class="mt-3 font-body text-xl">{priceLabel(book)}</p>
		<ButtonLink href={shopHref(book)} class="mt-5">
			{shopLabel(book)}
		</ButtonLink>
	</div>
</article>
